{% comment %}
  Renders a product card
  Accepts:
  - title: {String} Product title
  - price: {String} Product price
  - rating: {Number} Rating value (default: 5)
  - image_svg: {String} SVG markup or image path
  - boot_color: {String} Suede boot color
{% endcomment %}

<div class="product-card">
  <!-- Wishlist Heart Button -->
  <button type="button" class="wishlist-btn" aria-label="Add to wishlist">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
  </button>

  <!-- Product Image Container -->
  <div class="product-media">
    {% if image_svg %}
      {{ image_svg }}
    {% else %}
      <svg class="product-img" viewBox="0 0 280 280" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="280" height="280" fill="#fdfbfd" rx="12"/>
        <!-- Fur Collar -->
        <path d="M95 105 C95 85 185 85 185 105 C195 115 185 130 180 135 C175 140 105 140 100 135 C95 130 85 115 95 105 Z" fill="#ffffff" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.08))"/>
        <path d="M95 95 C110 90 170 90 185 95" stroke="#f0e6f5" stroke-width="6" stroke-linecap="round"/>
        <!-- Boot Upper Shaft -->
        <path d="M100 130 L105 200 C105 220 120 230 145 230 L200 230 C220 230 230 220 220 200 L180 130 Z" fill="{{ boot_color | default: '#f4a5ba' }}"/>
        <!-- Sole -->
        <path d="M95 230 C95 220 115 220 145 220 L210 220 C235 220 240 235 230 245 L105 245 C95 245 95 235 95 230 Z" fill="#f8f4f0"/>
        <path d="M95 245 L230 245 L225 252 L100 252 Z" fill="#3c2045"/>
        <!-- Laces & Eyelets -->
        <circle cx="130" cy="150" r="2.5" fill="#ffffff"/>
        <circle cx="150" cy="150" r="2.5" fill="#ffffff"/>
        <circle cx="135" cy="175" r="2.5" fill="#ffffff"/>
        <circle cx="155" cy="175" r="2.5" fill="#ffffff"/>
        <circle cx="140" cy="200" r="2.5" fill="#ffffff"/>
        <circle cx="160" cy="200" r="2.5" fill="#ffffff"/>
        <path d="M130 150 L155 175 M150 150 L135 175 M135 175 L160 200 M155 175 L140 200" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
      </svg>
    {% endif %}
  </div>

  <!-- Product Details -->
  <div class="product-info">
    <h3 class="product-title">
      <a href="/products/fur-lined-winter-boot">{{ title }}</a>
    </h3>

    <!-- Star Ratings -->
    <div class="product-rating" aria-label="5 out of 5 stars">
      <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
    </div>

    <!-- Price and Add to Cart -->
    <div class="product-footer">
      <span class="product-price">{{ price }}</span>
      <button type="button" class="add-to-cart-btn" aria-label="Add {{ title }} to Cart">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
      </button>
    </div>
  </div>
</div>
