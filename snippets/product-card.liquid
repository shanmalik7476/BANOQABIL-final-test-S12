{% comment %} Product Card Snippet - MEA'S SHOELLE {% endcomment %}
<div class="product-card">

  {% if product.tags contains 'new' %}
    <div class="product-badges"><span class="badge badge-new">NEW</span></div>
  {% elsif product.compare_at_price > product.price %}
    <div class="product-badges"><span class="badge badge-sale">SALE</span></div>
  {% elsif product.tags contains 'hot' %}
    <div class="product-badges"><span class="badge badge-hot">HOT</span></div>
  {% endif %}

  <button type="button" class="wishlist-btn" aria-label="Add {{ product.title }} to wishlist">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
    </svg>
  </button>

  <div class="product-media">
    <a href="{{ product.url }}">
      <img
        class="product-img"
        src="{{ product.featured_image | img_url: '500x500', crop: 'center' }}"
        alt="{{ product.featured_image.alt | escape }}"
        loading="lazy"
        width="500"
        height="500"
      >
    </a>
    <div class="product-overlay">
      <button class="quick-add-btn" data-product-id="{{ product.id }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}">
        + Quick Add
      </button>
    </div>
  </div>

  <div class="product-info">
    <h3 class="product-name"><a href="{{ product.url }}">{{ product.title }}</a></h3>

    {% if product.variants.size > 1 %}
      <div class="product-colors">
        {% for variant in product.variants limit: 4 %}
          {% if variant.option1 %}
            <span class="color-swatch {% if forloop.first %}active{% endif %}" title="{{ variant.option1 }}" style="background:{{ variant.option1 | downcase | replace: ' ', '' }};"></span>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="product-rating">
      <div class="stars">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      </div>
      <span class="rating-count">({{ product.metafields.reviews.rating_count | default: '0' }})</span>
    </div>

    <div class="product-footer">
      <div class="price-group">
        <span class="price-main">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="price-old">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>
      <button
        class="add-to-cart-btn"
        aria-label="Add {{ product.title }} to cart"
        data-product-id="{{ product.id }}"
        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
      </button>
    </div>
  </div>
</div>
