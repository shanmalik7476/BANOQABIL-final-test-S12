<section class="features-bar-section">
  <div class="container">
    <div class="features-grid">
      <!-- Feature 1: Free Shipping -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="feature-content">
          <span class="feature-title">Free shipping</span>
          <span class="feature-subtitle">On order over $100</span>
        </div>
      </div>

      <!-- Feature 2: Easy Returns -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 4v6h6"></path>
            <path d="M23 20v-6h-6"></path>
            <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
          </svg>
        </div>
        <div class="feature-content">
          <span class="feature-title">Easy Returns</span>
          <span class="feature-subtitle">Within 30 days</span>
        </div>
      </div>

      <!-- Feature 3: Secure Payment -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <rect x="9" y="10" width="6" height="5" rx="1" fill="currentColor"></rect>
          </svg>
        </div>
        <div class="feature-content">
          <span class="feature-title">Secure Payment</span>
          <span class="feature-subtitle">100% protected</span>
        </div>
      </div>

      <!-- Feature 4: Premium Quality -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="6"></circle>
            <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
          </svg>
        </div>
        <div class="feature-content">
          <span class="feature-title">Premium Quality</span>
          <span class="feature-subtitle">stylish & durable</span>
        </div>
      </div>

      <!-- Feature 5: 24/7 Support -->
      <div class="feature-box">
        <div class="feature-icon-wrapper">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
            <text x="7" y="11" font-size="7" font-weight="bold" fill="currentColor">24/7</text>
          </svg>
        </div>
        <div class="feature-content">
          <span class="feature-title">24/7 support</span>
          <span class="feature-subtitle">We're here to help</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features Bar",
  "settings": []
}
{% endschema %}
