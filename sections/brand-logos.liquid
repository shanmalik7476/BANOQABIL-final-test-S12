<section class="brand-logos-section">
  <div class="container">
    <div class="brand-logos-row">
      <!-- Adidas -->
      <div class="brand-logo-item" aria-label="Adidas">
        <svg viewBox="0 0 100 45" width="80" height="36" fill="currentColor">
          <path d="M12 36 L24 16 L32 16 L20 36 Z"/>
          <path d="M34 36 L48 10 L56 10 L42 36 Z"/>
          <path d="M58 36 L74 4 L82 4 L66 36 Z"/>
          <text x="8" y="44" font-family="'Plus Jakarta Sans', sans-serif" font-weight="900" font-size="10" letter-spacing="1">adidas</text>
        </svg>
      </div>

      <!-- Puma -->
      <div class="brand-logo-item" aria-label="Puma">
        <svg viewBox="0 0 100 45" width="85" height="36" fill="currentColor">
          <path d="M62 8 C68 4 78 8 82 14 C85 18 80 22 75 19 C70 16 66 18 64 22 C62 25 58 24 56 20 C54 16 58 11 62 8 Z M72 15 C76 12 80 15 78 18 C75 20 71 18 72 15 Z"/>
          <text x="5" y="32" font-family="'Plus Jakarta Sans', sans-serif" font-weight="900" font-size="20" letter-spacing="2">PUMA</text>
        </svg>
      </div>

      <!-- Steve Madden -->
      <div class="brand-logo-item" aria-label="Steve Madden">
        <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 17px; letter-spacing: 1.5px;">STEVE MADDEN</span>
      </div>

      <!-- Aldo Outlet -->
      <div class="brand-logo-item" aria-label="Aldo Outlet">
        <div style="display: flex; flex-direction: column; align-items: center; line-height: 1;">
          <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 900; font-size: 20px; letter-spacing: 3px;">ALDO</span>
          <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 9px; letter-spacing: 2px;">OUTLET</span>
        </div>
      </div>

      <!-- Zara -->
      <div class="brand-logo-item" aria-label="Zara">
        <span style="font-family: 'Playfair Display', serif; font-weight: 900; font-size: 26px; letter-spacing: 2px;">ZARA</span>
      </div>

      <!-- Converse -->
      <div class="brand-logo-item" aria-label="Converse">
        <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 900; font-size: 17px; letter-spacing: 1.5px; display: inline-flex; align-items: center; gap: 4px;">
          CONVERSE 
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          &gt;
        </span>
      </div>

      <!-- New Balance -->
      <div class="brand-logo-item" aria-label="New Balance">
        <div style="display: flex; flex-direction: column; align-items: center; line-height: 1;">
          <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-style: italic; font-weight: 900; font-size: 22px; letter-spacing: -1px;">NB</span>
          <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; font-size: 9px; letter-spacing: 1px;">new balance</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Logos",
  "settings": []
}
{% endschema %}
