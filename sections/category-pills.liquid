<section class="category-pills-section">
  <div class="container">
    <div class="category-pills-card">
      <!-- 1. Heels -->
      <a href="/collections/heels" class="category-item">
        <div class="category-icon-box">
          <svg viewBox="0 0 32 32" width="30" height="30" fill="currentColor">
            <path d="M4 25c5 0 9-2 12-6l3-4c1.5-2 3.5-3 6-3h4v4c-2 0-3.5 1-5 2.5l-3 3c-4 4-8 5.5-13 5.5v-2z"/>
            <path d="M26 12v14h-3V14c1-.8 2-1.5 3-2z"/>
          </svg>
        </div>
        <span class="category-label">Heels</span>
      </a>

      <!-- 2. sandals -->
      <a href="/collections/sandals" class="category-item">
        <div class="category-icon-box">
          <svg viewBox="0 0 32 32" width="30" height="30" fill="currentColor">
            <path d="M3 21c2-5 7-7 12-7h5c3 0 6 2 9 6v3H3v-2z"/>
            <path d="M2 24h28v3H2z"/>
            <path d="M9 16c2-1 4-1 6 0"/>
          </svg>
        </div>
        <span class="category-label">sandals</span>
      </a>

      <!-- 3. sneakers -->
      <a href="/collections/sneakers" class="category-item">
        <div class="category-icon-box">
          <svg viewBox="0 0 32 32" width="32" height="32" fill="currentColor">
            <path d="M3 22c2-4 6-6 10-6h6c3 0 6 2 9 6v2H3v-2z"/>
            <path d="M11 16l4-5h4l2 5"/>
            <path d="M2 23h28v3H2z"/>
          </svg>
        </div>
        <span class="category-label">sneakers</span>
      </a>

      <!-- 4. Boots -->
      <a href="/collections/boots" class="category-item">
        <div class="category-icon-box">
          <svg viewBox="0 0 32 32" width="30" height="30" fill="currentColor">
            <path d="M8 8h10v10l6 3v5H8V8z"/>
            <path d="M6 25h20v3H6z"/>
            <path d="M13 11h4M13 14h4M13 17h4" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <span class="category-label">Boots</span>
      </a>

      <!-- 5. new arrivals -->
      <a href="/collections/new-arrivals" class="category-item">
        <div class="category-icon-box">
          <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor">
            <path d="M6 10h20l3 16H3L6 10z"/>
            <path d="M11 10V7a5 5 0 0 1 10 0v3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="16" cy="18" r="2.5" fill="#ffffff"/>
          </svg>
        </div>
        <span class="category-label">new arrivals</span>
      </a>

      <!-- 6. best Sellers -->
      <a href="/collections/best-sellers" class="category-item">
        <div class="category-icon-box">
          <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 6l18 0l5 7l-14 15l-14 -15z" />
            <path d="M2 13l28 0" />
            <path d="M16 28l-5 -15l3 -7" />
            <path d="M16 28l5 -15l-3 -7" />
          </svg>
        </div>
        <span class="category-label">best Sellers</span>
      </a>

      <!-- 7. sales -->
      <a href="/collections/sales" class="category-item">
        <div class="category-icon-box">
          <svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 3l14 14a2 2 0 0 1 0 2.8l-8.2 8.2a2 2 0 0 1 -2.8 0L3 14V3h11z"/>
            <circle cx="8.5" cy="8.5" r="2.5" fill="currentColor"/>
          </svg>
        </div>
        <span class="category-label">sales</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Pills Bar",
  "settings": []
}
{% endschema %}
