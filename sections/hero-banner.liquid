<section class="hero-section">
  <!-- Subtle organic palm leaf ambient shadow in top left -->
  <div class="hero-ambient-leaf"></div>

  <div class="container">
    <div class="hero-grid">
      <!-- Left Content Column -->
      <div class="hero-content">
        <span class="hero-eyebrow">{{ section.settings.eyebrow_text | default: 'STEP INTO COFIDENCE' }}</span>
        
        <h1 class="hero-title">
          <span>Shoes That</span>
          <span>Define you</span>
        </h1>
        
        <p class="hero-subtitle">
          {{ section.settings.subtitle_text | default: 'chic styles, premium comfort and elegance in every step.' }}
        </p>

        <div class="hero-button-group">
          <a href="{{ section.settings.shop_now_link | default: '/collections/all' }}" class="btn-primary-purple">
            {{ section.settings.shop_now_text | default: 'SHOP NOW' }} &rarr;
          </a>
          
          <button type="button" class="btn-video-watch">
            <span class="play-icon-circle">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </span>
            <span>watch video</span>
          </button>
        </div>
      </div>

      <!-- Right Visual Column (Authentic Commercial Studio Purple Running Sneakers) -->
      <div class="hero-media-wrapper">
        <div class="hero-showcase-container">
          <img 
            src="{{ 'hero-sneaker-showcase-transparent.png' | asset_url }}" 
            alt="Shoes That Define you - Purple Athletic Running Sneakers"
            class="hero-showcase-img"
            loading="eager"
            width="530"
            height="510"
          >
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "STEP INTO COFIDENCE"
    },
    {
      "type": "text",
      "id": "subtitle_text",
      "label": "Subtitle",
      "default": "chic styles, premium comfort and elegance in every step."
    },
    {
      "type": "text",
      "id": "shop_now_text",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_now_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
