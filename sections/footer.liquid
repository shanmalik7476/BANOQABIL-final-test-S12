<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Newsletter -->
      <div class="footer-col">
        <h4 class="footer-col-title">SUBSCRIBE & GET 10% OFF</h4>
        <p class="newsletter-desc">
          Join our newsletter and be the first to know about new arrival and exclusive offers
        </p>
        <form class="newsletter-form" action="#" method="post">
          <input type="email" class="newsletter-input" placeholder="Enter your email" required aria-label="Email address">
          <button type="submit" class="btn-newsletter-subscribe">SUBSCRIBE</button>
        </form>
      </div>

      <!-- Col 2: SHOP -->
      <div class="footer-col">
        <h4 class="footer-col-title">SHOP</h4>
        <ul class="footer-links-list">
          <li><a href="/collections/all">All Products</a></li>
          <li><a href="/collections/new-arrivals">New Arrivals</a></li>
          <li><a href="/collections/best-sellers">Best Sellers</a></li>
          <li><a href="/collections/heels">Heels</a></li>
          <li><a href="/collections/sneakers">Sneakers</a></li>
          <li><a href="/collections/boots">Boots</a></li>
        </ul>
      </div>

      <!-- Col 3: HELP -->
      <div class="footer-col">
        <h4 class="footer-col-title">HELP</h4>
        <ul class="footer-links-list">
          <li><a href="/pages/shipping">Shipping and Delivery</a></li>
          <li><a href="/pages/returns">Return & Exchanges</a></li>
          <li><a href="/pages/size-guide">Size Guide</a></li>
          <li><a href="/pages/faqs">FAQs</a></li>
          <li><a href="/pages/track-order">Track Order</a></li>
          <li><a href="/pages/contact">contact Us</a></li>
        </ul>
      </div>

      <!-- Col 4: ABOUT -->
      <div class="footer-col">
        <h4 class="footer-col-title">ABOUT</h4>
        <ul class="footer-links-list">
          <li><a href="/pages/about-us">About Us</a></li>
          <li><a href="/pages/our-stores">Our stores</a></li>
          <li><a href="/pages/careers">Careers</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms & Conditions</a></li>
        </ul>
      </div>

      <!-- Col 5: FOLLOW US & PAYMENTS -->
      <div class="footer-col">
        <h4 class="footer-col-title">FOLLOW US</h4>
        <div class="social-icons-row">
          <!-- Facebook -->
          <a href="https://facebook.com" target="_blank" rel="noopener" class="social-icon-btn" aria-label="Facebook">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
          <!-- Instagram -->
          <a href="https://instagram.com" target="_blank" rel="noopener" class="social-icon-btn" aria-label="Instagram">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <!-- TikTok -->
          <a href="https://tiktok.com" target="_blank" rel="noopener" class="social-icon-btn" aria-label="TikTok">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.81 4.48 6.3 6.3 0 0 0 1.83-4.47V8.62a8.27 8.27 0 0 0 4.75 1.51v-3.44h-.8z"></path>
            </svg>
          </a>
          <!-- Pinterest -->
          <a href="https://pinterest.com" target="_blank" rel="noopener" class="social-icon-btn" aria-label="Pinterest">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a10 10 0 0 0-3.66 19.31c-.05-.8-.1-2.03.02-2.9.11-.79.74-5.2.74-5.2s-.19-.38-.19-.94c0-.88.51-1.54 1.15-1.54.54 0 .8.41.8.9 0 .55-.35 1.36-.53 2.12-.15.64.32 1.15.95 1.15 1.14 0 2.02-1.2 2.02-2.93 0-1.53-1.1-2.6-2.67-2.6-1.82 0-2.88 1.36-2.88 2.77 0 .55.21 1.14.48 1.46.05.06.06.12.04.18-.04.18-.15.6-.17.68-.03.11-.1.15-.22.1-1-.46-1.62-1.92-1.62-3.1 0-2.52 1.83-4.84 5.28-4.84 2.77 0 4.93 1.98 4.93 4.62 0 2.76-1.74 4.97-4.15 4.97-.81 0-1.57-.42-1.83-.92l-.5 1.9c-.18.69-.67 1.56-1 2.09A10 10 0 1 0 12 2z"></path>
            </svg>
          </a>
        </div>

        <p class="payment-methods-title">We accept</p>
        <div class="payment-badges-row">
          <span class="payment-badge" style="font-weight: 900; color: #1a1f71;">VISA</span>
          <span class="payment-badge" style="font-weight: 800; color: #eb001b;">MC</span>
          <span class="payment-badge" style="font-weight: 800; color: #003087;">PayPal</span>
          <span class="payment-badge" style="font-weight: 700; color: #000000;">Pay</span>
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
