    {% render 'product-card', title: 'Red Fur-Lined Winter Boot', price: '$44.99', boot_color: '#9e1f37' %}
    {% render 'product-card', title: 'Beige Fur-Lined Winter Boot', price: '$69.99', boot_color: '#d6be9a' %}
